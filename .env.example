# Copy this file to .env and change the values.
DATABASE_URL=sqlite:///./fitness.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/fitness_db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=30
# Free key from https://api.data.gov/signup/ (DEMO_KEY works for a few requests per hour)
USDA_API_KEY=DEMO_KEY
OFF_USER_AGENT=FitnessApp/0.1 (contact@example.com)
# WHOOP (optional): keys from your app at https://developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/api/whoop/callback
# Coach chatbot. auto = Claude if ANTHROPIC_API_KEY is set, otherwise Ollama on this PC
ASSISTANT_PROVIDER=auto
# Free, local: install Ollama (https://ollama.com), run `ollama pull qwen3:8b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Recognises machines from a photo (Workouts > Photo): ollama pull qwen3-vl:8b
OLLAMA_VISION_MODEL=qwen3-vl:8b
# OLLAMA_NUM_CTX=16384
# Voice messages (speech to text on this PC; the model downloads once, about 500 MB)
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_LANGUAGE=
# Paid, online: an API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_DAILY_LIMIT=50
# Recognising machines from your own earlier photos (model downloads once, 351 MB:
# uv run python -m app.services.photo_match). Higher = fewer but surer matches.
# PHOTO_MATCH_THRESHOLD=0.90
