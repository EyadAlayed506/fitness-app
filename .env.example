# Copy this file to .env and change the values.
DATABASE_URL=sqlite:///./fitness.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/fitness_db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=30
# Free key from https://api.data.gov/signup/ (DEMO_KEY works for a few requests per hour)
USDA_API_KEY=DEMO_KEY
OFF_USER_AGENT=FitnessApp/0.1 (contact@example.com)
