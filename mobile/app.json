{
  "expo": {
    "name": "Fitness App",
    "slug": "fitness-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eyadalayed.fitnessapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2A78D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.eyadalayed.fitnessapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to scan the QR code on gym machines and to recognise machines from a photo.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "The microphone is used for voice messages to your coach and, when you turn on hands-free mode, to hear your workout commands."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app uses a photo you choose to recognise gym machines.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "fitnessapp",
    "experiments": {
      "typedRoutes": false
    }
  }
}
